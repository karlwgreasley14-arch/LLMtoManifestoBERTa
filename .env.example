# OpenRouter API key (required for cloud models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: override database path (default: data/thesis_data.db)
# DB_PATH=data/thesis_data.db

# Optional: Ollama endpoint (default: http://localhost:11434/v1/chat/completions)
# OLLAMA_URL=http://localhost:11434/v1/chat/completions

# Optional: override day number (default: calculated from study start 2026-08-25)
# DAY_NUMBER=1
